+class ExtensionsHandler::LoadUnpackedContext
+    : public base::RefCounted<ExtensionsHandler::LoadUnpackedContext> {
+ public:
+  LoadUnpackedContext(content::BrowserContext* browser_context,
+                      std::optional<protocol::String> expected_id,
+                      std::optional<bool> user_scripts_access)
+      : browser_context_(browser_context),
+        expected_id_(std::move(expected_id)),
+        user_scripts_access_(user_scripts_access) {}
+
+  std::u16string BeforeInstall(const extensions::Extension& extension) {
+    extension_id_ = extension.id();
+    if (expected_id_.has_value() && extension_id_ != *expected_id_) {
+      return u"Extension ID does not match expectedId.";
+    }
+
+    extensions::ExtensionRegistry* registry =
+        extensions::ExtensionRegistry::Get(browser_context_);
+    was_installed_before_ =
+        registry && registry->GetInstalledExtension(extension_id_) != nullptr;
+    prepared_ = true;
+
+    if (!user_scripts_access_.has_value()) {
+      return std::u16string();
+    }
+
+    if (!extensions::UserScriptManager::IsUserScriptsAPIPermissionAvailable(
+            extension)) {
+      return u"Extension does not declare the userScripts permission.";
+    }
+
+    user_scripts_access_transaction_ =
+        std::make_unique<UserScriptsAccessTransaction>(
+            browser_context_, extension_id_, *user_scripts_access_);
+    return std::u16string();
+  }
+
+  bool has_atomic_options() const {
+    return expected_id_.has_value() || user_scripts_access_.has_value();
+  }
+
+  bool CommitIfEnabled(const extensions::Extension* extension,
+                       std::u16string* error) {
+    if (!prepared_ || !extension || extension->id() != extension_id_) {
+      *error = u"Extension load did not reach installation.";
+      return false;
+    }
+
+    extensions::ExtensionRegistry* registry =
+        extensions::ExtensionRegistry::Get(browser_context_);
+    if (!registry ||
+        !registry->enabled_extensions().Contains(extension_id_)) {
+      *error = u"Extension was installed but is not enabled.";
+      return false;
+    }
+
+    if (g_fail_load_unpacked_before_commit_for_testing) {
+      g_fail_load_unpacked_before_commit_for_testing = false;
+      *error = u"Injected loadUnpacked failure before commit.";
+      return false;
+    }
+
+    if (user_scripts_access_transaction_) {
+      user_scripts_access_transaction_->Commit();
+    }
+    return true;
+  }
+
+  void RemoveNewRegistryEntry() {
+    if (!prepared_ || was_installed_before_ || extension_id_.empty()) {
+      return;
+    }
+
+    extensions::ExtensionRegistry* registry =
+        extensions::ExtensionRegistry::Get(browser_context_);
+    if (!registry || !registry->GetInstalledExtension(extension_id_)) {
+      return;
+    }
+
+    std::u16string error;
+    bool initiated =
+        extensions::ExtensionRegistrar::Get(browser_context_)
+            ->UninstallExtension(
+                extension_id_, extensions::UNINSTALL_REASON_INTERNAL_MANAGEMENT,
+                &error);
+    CHECK(initiated) << base::UTF16ToUTF8(error);
+    CHECK(!registry->GetInstalledExtension(extension_id_));
+  }
+
+ private:
+  friend class base::RefCounted<LoadUnpackedContext>;
+
+  class UserScriptsAccessTransaction {
+   public:
+    UserScriptsAccessTransaction(content::BrowserContext* browser_context,
+                                 const extensions::ExtensionId& extension_id,
+                                 bool enabled)
+        : browser_context_(browser_context),
+          prefs_(extensions::ExtensionPrefs::Get(browser_context)),
+          extension_id_(extension_id),
+          context_id_(extensions::util::GetBrowserContextId(browser_context)),
+          current_state_(extensions::GetCurrentUserScriptAllowedState(
+              context_id_, extension_id_)) {
+      pref_was_present_ = prefs_->ReadPrefAsBoolean(
+          extension_id_,
+          extensions::UserScriptManager::kUserScriptsAllowedPref,
+          &pref_value_);
+      prefs_->SetBooleanPref(
+          extension_id_,
+          extensions::UserScriptManager::kUserScriptsAllowedPref, enabled);
+      extensions::SetCurrentUserScriptAllowedState(context_id_, extension_id_,
+                                                   enabled);
+    }
+
+    UserScriptsAccessTransaction(const UserScriptsAccessTransaction&) = delete;
+    UserScriptsAccessTransaction& operator=(
+        const UserScriptsAccessTransaction&) = delete;
+
+    ~UserScriptsAccessTransaction() {
+      if (committed_) {
+        return;
+      }
+
+      extensions::ExtensionRegistry* registry =
+          extensions::ExtensionRegistry::Get(browser_context_);
+      if (registry && registry->enabled_extensions().Contains(extension_id_)) {
+        const bool runtime_state = current_state_.value_or(
+            pref_was_present_ ? pref_value_ : false);
+        extensions::ExtensionSystem::Get(browser_context_)
+            ->user_script_manager()
+            ->SetUserScriptPrefEnabled(extension_id_, runtime_state);
+      }
+
+      if (pref_was_present_) {
+        prefs_->SetBooleanPref(
+            extension_id_,
+            extensions::UserScriptManager::kUserScriptsAllowedPref,
+            pref_value_);
+      } else {
+        bool current_pref_value = false;
+        if (prefs_->ReadPrefAsBoolean(
+                extension_id_,
+                extensions::UserScriptManager::kUserScriptsAllowedPref,
+                &current_pref_value)) {
+          prefs_->UpdateExtensionPref(
+              extension_id_,
+              extensions::UserScriptManager::kUserScriptsAllowedPref.name,
+              std::nullopt);
+        }
+      }
+
+      if (current_state_.has_value()) {
+        extensions::SetCurrentUserScriptAllowedState(
+            context_id_, extension_id_, *current_state_);
+      } else {
+        extensions::ClearCurrentUserScriptAllowedState(context_id_,
+                                                       extension_id_);
+      }
+    }
+
+    void Commit() { committed_ = true; }
+
+   private:
+    const raw_ptr<content::BrowserContext> browser_context_;
+    raw_ptr<extensions::ExtensionPrefs> prefs_;
+    const extensions::ExtensionId extension_id_;
+    const int context_id_;
+    const std::optional<bool> current_state_;
+    bool pref_was_present_ = false;
+    bool pref_value_ = false;
+    bool committed_ = false;
+  };
+
+  ~LoadUnpackedContext() = default;
+
+  const raw_ptr<content::BrowserContext> browser_context_;
+  const std::optional<protocol::String> expected_id_;
+  const std::optional<bool> user_scripts_access_;
+  extensions::ExtensionId extension_id_;
+  bool prepared_ = false;
+  bool was_installed_before_ = false;
+  std::unique_ptr<UserScriptsAccessTransaction>
+      user_scripts_access_transaction_;
+};
