+protocol::DispatchResponse ExtensionsHandler::SetUserScriptsAccess(
+    const protocol::String& id,
+    bool enabled) {
+  if (!allow_loading_extensions_) {
+    return protocol::Response::ServerError("Method not available.");
+  }
+
+  auto host = content::DevToolsAgentHost::GetForId(target_id_);
+  if (!host ||
+      host->GetType() != content::DevToolsAgentHost::kTypeBrowser) {
+    return protocol::Response::ServerError(
+        "Method is only available on the browser target.");
+  }
+
+  content::BrowserContext* context =
+      DevToolsBrowserContextManager::GetInstance().GetDefaultBrowserContext();
+  if (!context) {
+    return protocol::Response::ServerError(
+        "Could not find the current browser context.");
+  }
+
+  extensions::ExtensionRegistry* registry =
+      extensions::ExtensionRegistry::Get(context);
+  const extensions::Extension* extension =
+      registry ? registry->enabled_extensions().GetByID(id) : nullptr;
+  if (!extension) {
+    return protocol::Response::InvalidRequest(
+        "Extension is not installed and enabled in the current profile.");
+  }
+
+  if (!extensions::Manifest::IsUnpackedLocation(extension->location())) {
+    return protocol::Response::InvalidRequest(
+        "Extension is not an unpacked extension.");
+  }
+
+  if (!extensions::UserScriptManager::IsUserScriptsAPIPermissionAvailable(
+          *extension)) {
+    return protocol::Response::InvalidRequest(
+        "Extension does not declare the userScripts permission.");
+  }
+
+  extensions::ExtensionSystem::Get(context)
+      ->user_script_manager()
+      ->SetUserScriptPrefEnabled(id, enabled);
+  return protocol::DispatchResponse::Success();
+}
