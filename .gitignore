# Ignore all untracked files by default.
*

# Generated Python cache files remain ignored despite tooling whitelists below.
__pycache__/
*.py[cod]

# Repository control files.
!.gitignore
!AGENTS.md

# Userscripts.
!*.user.js

# Maintained documentation, grouped by responsibility.
!docs/
!docs/development/
!docs/development/*.md
!docs/userscripts/
!docs/userscripts/*.md
!docs/sites/
!docs/sites/*.md
!docs/sites/*/
!docs/sites/*/*.md

# Build inputs and vendored runtime used by tracked scripts.
!package.json
!pnpm-lock.yaml
!src/
!src/lib/
!src/lib/digiphile/
!src/lib/digiphile/*.js
!src/lib/douban/
!src/lib/douban/*.js
!src/lib/keylol/
!src/lib/keylol/*.js
!src/lib/steampy/
!src/lib/steampy/*.js
!src/lib/gmg/
!src/lib/gmg/*.js
!src/lib/planetplay/
!src/lib/planetplay/*.js
!src/lib/sonkwo/
!src/lib/sonkwo/*.js
!src/lib/steam/
!src/lib/steam/*.js
!src/lib/steamdb/
!src/lib/steamdb/*.js
!src/lib/zlib/
!src/lib/zlib/*.js
!src/lib/bilibili/
!src/lib/bilibili/*.js
!src/lib/page-agent/
!src/lib/page-agent/*.js
!src/lib/userscript/
!src/lib/userscript/*.js
!src/userscripts/
!src/userscripts/.gitkeep
!src/userscripts/*.user.js
!scripts/
!scripts/build-page-agent.sh
!scripts/build-userscripts.mjs
!scripts/page-agent-userscript-entry.ts
!scripts/userscripts/
!scripts/userscripts/install-to-scriptcat.mjs
!scripts/userscripts/install-to-scriptcat.test.mjs
!scripts/userscripts/discovery-queue-auto-filter.test.mjs
!scripts/userscripts/steam-key-toolbar.test.mjs
!scripts/userscripts/steampy-plus-seller-batch.test.mjs
!scripts/userscripts/steampy-plus-sale-start-time.test.mjs
!scripts/userscripts/steampy-plus-rating.test.mjs
!scripts/userscripts/steampy-plus-filter.test.mjs
!scripts/userscripts/zlib-local-owned-mark.test.mjs
!scripts/userscripts/lint-built.cjs
!scripts/userscripts/lint.cjs
!scripts/userscripts/scriptcat-vscode-sync.mjs
!scripts/userscripts/scriptcat-eslint/
!scripts/userscripts/scriptcat-eslint/*.cjs
!vendor/
!vendor/page-agent.js

# MCP source pin and local publication tools.
!browser/
!browser/mcp.lock.json
!browser/chrome-devtools-mcp
!browser/scriptcat
!.gitmodules
!scripts/pyproject.toml
!scripts/uv.lock
!scripts/scriptcat/
!scripts/scriptcat/**
scripts/scriptcat/__pycache__/
scripts/scriptcat/**/*.pyc
!scripts/mcp/
!scripts/mcp/**
scripts/mcp/__pycache__/
scripts/mcp/**/*.pyc
!scripts/release_tools/
!scripts/release_tools/**
scripts/release_tools/__pycache__/
scripts/release_tools/**/*.pyc

# Shared Cursor rules. Local MCP client config is machine-specific and stays untracked.
!.cursor/
!.cursor/rules/
!.cursor/rules/scriptcat-context.mdc
!.cursor/rules/scriptcat-userscript-quality.mdc

# Project-local skill used by ScriptCat MCP setup.
!.agents/
!.agents/skills/
!.agents/skills/scriptcat-script-setup/
!.agents/skills/scriptcat-script-setup/**
!.agents/skills/steampy-batch-cdkey-input/
!.agents/skills/steampy-batch-cdkey-input/**

# Machine-specific local MCP client configs. Paths differ per checkout.
# Do not re-add these with a leading ! exception.
.codex/
.mcp.json
.cursor/mcp.json
