!vendor/
!vendor/page-agent.js

# Browser and MCP source pins, local publication tools, and remote provider tooling.
!browser/
!browser/mcp.lock.json
!browser/provider.lock.json
!browser/chrome-devtools-mcp
!browser/scriptcat
!.gitmodules
