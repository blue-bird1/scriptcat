# Ignore all untracked files by default.
*

# Repository control files.
!.gitignore
!AGENTS.md

# Userscripts.
!*.user.js

# Project documentation that is already part of the repository.
# !docs/
# !docs/troubleshooting.md
# !docs/steampy-pro-cdkey-investigation.md
# !docs/plans/
# !docs/plans/steampy-pro-cdkey-adaptation-plan.md

# Build inputs and vendored runtime used by tracked scripts.
!package.json
!pnpm-lock.yaml
!src/
!src/lib/
!src/lib/douban/
!src/lib/douban/*.js
!src/lib/keylol/
!src/lib/keylol/*.js
!src/lib/steampy/
!src/lib/steampy/*.js
!src/lib/gmg/
!src/lib/gmg/*.js
!src/lib/sonkwo/
!src/lib/sonkwo/*.js
!src/lib/zlib/
!src/lib/zlib/*.js
!src/lib/bilibili/
!src/lib/bilibili/*.js
!src/lib/page-agent/
!src/lib/page-agent/*.js
!src/lib/userscript/
!src/lib/userscript/*.js
!src/userscripts/
!src/userscripts/.gitkeep
!src/userscripts/*.user.js
!scripts/
!scripts/build-page-agent.sh
!scripts/build-userscripts.mjs
!scripts/page-agent-userscript-entry.ts
!scripts/userscripts/
!scripts/userscripts/install-to-scriptcat.mjs
!scripts/userscripts/lint-built.cjs
!scripts/userscripts/lint.cjs
!scripts/userscripts/scriptcat-eslint/
!scripts/userscripts/scriptcat-eslint/*.cjs
!vendor/
!vendor/page-agent.js

# Project-scoped Codex MCP setup for ScriptCat debugging.
# !.codex/
